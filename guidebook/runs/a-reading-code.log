$ # step 4: hostile input — the exact character where data becomes structure
$ python3 querybuilder.py "' OR '1'='1" x
VULNERABLE: SELECT * FROM users WHERE name = '' OR '1'='1' AND pw = 'x'
SAFE      : ('SELECT * FROM users WHERE name = ? AND pw = ?', ("' OR '1'='1", 'x'))
# The first ' of the input closes the string literal: input stops being data
# at that character and becomes SQL syntax. The safe builder keeps the whole
# hostile string as one inert tuple value — placeholders never re-parse input.

