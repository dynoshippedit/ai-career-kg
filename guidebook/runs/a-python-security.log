$ # step 7: the reader's first edit — save the fetched body to a file
$ python3 - << 'EOF'
import urllib.request
with urllib.request.urlopen("http://127.0.0.1:8471/json", timeout=5) as r:
    body = r.read()
with open("/tmp/pywalk/saved.json", "wb") as f:
    f.write(body)
print("saved", len(body), "bytes")
EOF
saved 47 bytes
$ cat /tmp/pywalk/saved.json
{"service": "pywalk", "version": 3, "ok": true}

